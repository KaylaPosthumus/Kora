# Firebase web app config (Project settings → Your apps → Web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: point the SDK at the local emulator suite
VITE_USE_FIREBASE_EMULATORS=false

# Cloudinary (kept from the old app — used by the upload widgets)
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Seed script only (scripts/seed.mjs) — path to a service account JSON key
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
FIREBASE_PROJECT_ID=
SEED_ADMIN_EMAIL=admin@kora.test
SEED_ADMIN_PASSWORD=Password123!
SEED_EMPLOYEE_EMAIL=employee@kora.test
SEED_EMPLOYEE_PASSWORD=Password123!
